{
  "name": "pcg-astro7-full-feature-example-pnpm",
  "type": "esm",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:pcg": "npx --yes --package=esa-pcg-cli@0.1.23-beta.7 pcg build --framework astro --dir .",
    "start:pcg": "pnpm run build:pcg && npx --yes --package=esa-pcg-cli@0.1.23-beta.7 pcg serve --dir . --port 6177 --gateway http://127.0.0.1:7001 --app-id local_user/local_app --secret local-dev-secret",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "6.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "astro": "7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  },
  "packageManager": "pnpm@10.23.0",
  "private": true
}
