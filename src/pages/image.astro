---
import { Image } from 'astro:assets';
import logo from '../assets/astro-logo.svg';
import localLandscape from '../assets/local-landscape.png';
import Layout from '../layouts/Layout.astro';

export const prerender = false;
const externalImageUrl =
  'https://zos.alipayobjects.com/rmsportal/jkjgkEfvpUPVyRjUImniVslZfWPnJuuZ.png';
---

<Layout title="Astro 7 Image Optimization">
  <h1>Image Optimization</h1>
  <section class="card">
    <h2>Runtime Image Endpoint</h2>
    <Image
      id="runtime-image"
      src={logo}
      width={160}
      height={160}
      format="svg"
      alt="Astro logo optimized by the runtime image endpoint"
    />
    <p>请求由官方 Node Adapter 的 <code>/_image</code> Endpoint 处理。</p>
  </section>

  <section class="card" id="local-image-optimization">
    <h2>本地图片优化</h2>
    <Image
      id="local-optimized-image"
      src={localLandscape}
      width={720}
      height={450}
      format="webp"
      quality={75}
      alt="A locally imported landscape optimized to WebP by Astro"
    />
    <p>
      从 <code>src/assets/local-landscape.png</code> 静态导入，在请求时缩放到
      <code>720 × 450</code>，并以质量 <code>75</code> 转换为 WebP。
    </p>
  </section>

  <section class="card" id="external-image-optimization">
    <h2>外部图片优化</h2>
    <Image
      id="external-optimized-image"
      src={externalImageUrl}
      width={502}
      height={493}
      format="webp"
      quality={75}
      loading="eager"
      alt="An external PNG optimized to WebP by Astro"
    />
    <p>
      从远程 PNG 原图 <code>1004 × 986</code> 缩放到 <code>502 × 493</code>，并以质量
      <code>75</code> 转换为 WebP。
    </p>
  </section>
</Layout>

<style>
  #local-optimized-image,
  #external-optimized-image {
    display: block;
    height: auto;
    border-radius: 12px;
  }

  #local-optimized-image {
    width: min(100%, 720px);
  }

  #external-optimized-image {
    width: min(100%, 502px);
  }
</style>
