---
import Layout from '../layouts/Layout.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
console.log('[console-log] SSR page requested');
---

<Layout title="Astro 7 Console 日志测试">
  <h1>Console 日志测试</h1>
  <section class="card">
    <p>访问此页会在服务端打印 SSR 日志。点击按钮会在浏览器打印点击日志，并在服务端打印 Action 日志。</p>
    <button id="log-action" type="button">打印日志并调用 Action</button>
    <p id="log-action-result" role="status"></p>
  </section>
</Layout>

<script>
  import { actions } from 'astro:actions';

  const result = document.getElementById('log-action-result')!;
  document.getElementById('log-action')?.addEventListener('click', async () => {
    console.log('[console-log] Action button clicked');
    const formData = new FormData();
    formData.set('name', 'PCG');
    result.textContent = '正在调用 Action…';
    try {
      const { data, error } = await actions.greet(formData);
      result.textContent = error ? `Action 调用失败：${error.message}` : data.message;
    } catch (error) {
      result.textContent = `Action 调用失败：${String(error)}`;
    }
  });
</script>
